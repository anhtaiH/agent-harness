{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Harness Orchestration Plan",
  "type": "object",
  "required": ["task_id", "created_at", "steps"],
  "properties": {
    "task_id": {"type": "string"},
    "created_at": {"type": "string"},
    "planner": {"type": "string"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "goal", "depends_on", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "role": {"enum": ["researcher", "worker", "qa", "reviewer", "security", "synthesizer"]},
          "goal": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "group": {"type": "string"},
          "status": {"enum": ["pending", "running", "done", "failed", "blocked"]},
          "attempts": {"type": "integer", "minimum": 0},
          "verdict": {"type": ["string", "null"]},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
