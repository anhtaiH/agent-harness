{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/state-anchor-receipt.v1.schema.json",
  "type": "object",
  "required": ["schema", "schema_version", "created_at", "installation_id", "anchor_namespace", "anchor_backend_id", "receipt_key_id", "transition_domain", "transition_digest", "old_generation", "old_commitment", "new_generation", "new_commitment", "operation_id", "broker_receipt"],
  "properties": {
    "schema": {"const": "agent-harness/state-anchor-receipt"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "installation_id": {"type": "string", "format": "uuid"},
    "anchor_namespace": {"type": "string", "minLength": 1},
    "anchor_backend_id": {"type": "string", "minLength": 1},
    "receipt_key_id": {"type": "string", "minLength": 1},
    "transition_domain": {"type": "string", "minLength": 1},
    "transition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "old_generation": {"type": "integer", "minimum": 0},
    "old_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "new_generation": {"type": "integer", "minimum": 1},
    "new_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_id": {"type": "string", "minLength": 1},
    "broker_receipt": {"type": "string", "minLength": 1},
    "mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
