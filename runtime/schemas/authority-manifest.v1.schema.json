{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/authority-manifest.v1.schema.json",
  "type": "object",
  "required": ["schema", "schema_version", "created_at", "installation_id", "launcher_code_identity", "launcher_content_digest", "native_broker_code_identity", "native_broker_content_digest", "approval_public_key_digest", "approval_persistent_reference", "anchor_backend_id", "anchor_namespace", "receipt_key_id", "receipt_public_key_digest", "receipt_persistent_reference", "terminal_pin_locator", "terminal_pin_attributes", "capability_state", "bootstrap_digest", "pending_plan_commitment", "broker_signature"],
  "properties": {
    "schema": {"const": "agent-harness/authority-manifest"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "installation_id": {"type": "string", "format": "uuid"},
    "launcher_code_identity": {"type": "string", "minLength": 1},
    "launcher_content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_broker_code_identity": {"type": "string", "minLength": 1},
    "native_broker_content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_public_key_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_persistent_reference": {"type": "string", "minLength": 1},
    "anchor_backend_id": {"type": "string", "minLength": 1},
    "anchor_namespace": {"type": "string", "minLength": 1},
    "receipt_key_id": {"type": "string", "minLength": 1},
    "receipt_public_key_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_persistent_reference": {"type": "string", "minLength": 1},
    "terminal_pin_locator": {"type": "string", "minLength": 1},
    "terminal_pin_attributes": {"type": "object"},
    "capability_state": {"type": ["array", "object"]},
    "bootstrap_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pending_plan_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "broker_signature": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
