{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/authority-bootstrap-wal.v1.schema.json",
  "type": "object",
  "required": ["schema", "schema_version", "created_at", "installation_id", "locators", "broker_code_identity", "creator_id", "item_attributes", "conditional_inverses", "phase", "broker_signature"],
  "properties": {
    "schema": {"const": "agent-harness/authority-bootstrap-wal"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "installation_id": {"type": "string", "format": "uuid"},
    "locators": {"type": "object"},
    "broker_code_identity": {"type": "string", "minLength": 1},
    "creator_id": {"type": "string", "minLength": 1},
    "item_attributes": {"type": "object"},
    "conditional_inverses": {"type": "array", "items": {"type": "object"}},
    "phase": {"type": "string", "minLength": 1},
    "broker_signature": {"type": ["string", "null"], "minLength": 1}
  },
  "additionalProperties": true
}
