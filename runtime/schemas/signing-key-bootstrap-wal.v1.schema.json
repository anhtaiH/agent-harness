{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/signing-key-bootstrap-wal.v1.schema.json",
  "type": "object",
  "required": ["schema", "schema_version", "created_at", "installation_id", "keychain_locator", "operation_id", "creator_id", "item_attributes", "conditional_inverse", "phase", "mac"],
  "properties": {
    "schema": {"const": "agent-harness/signing-key-bootstrap-wal"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "installation_id": {"type": "string", "format": "uuid"},
    "keychain_locator": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "creator_id": {"type": "string", "minLength": 1},
    "item_attributes": {"type": "object"},
    "conditional_inverse": {"type": "object"},
    "phase": {"type": "string", "minLength": 1},
    "mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
