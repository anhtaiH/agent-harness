{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Harness PR Review Finding",
  "type": "object",
  "required": [
    "id",
    "lane",
    "severity",
    "confidence",
    "file",
    "line",
    "title",
    "failure_scenario",
    "introduced_by_pr",
    "evidence",
    "how_to_verify",
    "minimal_fix"
  ],
  "properties": {
    "id": {"type": "string"},
    "lane": {"type": "string"},
    "severity": {"enum": ["critical", "high", "medium", "low", "nit"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "file": {"type": "string"},
    "line": {"type": ["integer", "null"], "minimum": 1},
    "title": {"type": "string"},
    "failure_scenario": {"type": "string"},
    "introduced_by_pr": {"type": "string"},
    "evidence": {"type": "string"},
    "how_to_verify": {"type": "string"},
    "minimal_fix": {"type": "string"},
    "discard_reason": {"type": "string"}
  }
}
