#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"

if [ "${1:-}" = "--self-test" ] && [ "$#" -eq 1 ]; then
  WORK="$(mktemp -d "${TMPDIR:-/tmp}/ah-authority-self-test.XXXXXX")"
  cleanup() {
    rm -rf "$WORK"
  }
  trap cleanup EXIT
  SWIFTC="$(/usr/bin/xcrun --find swiftc)"
  SDK="$(/usr/bin/xcrun --sdk macosx --show-sdk-path)"
  SDK_VERSION="$(/usr/bin/xcrun --sdk macosx --show-sdk-version)"
  SDK_MAJOR="${SDK_VERSION%%.*}"
  ARCH="$(/usr/bin/uname -m)"
  SWIFT_MODULECACHE_PATH="$WORK/swift-module-cache" \
    CLANG_MODULE_CACHE_PATH="$WORK/clang-module-cache" \
    "$SWIFTC" -sdk "$SDK" -target "$ARCH-apple-macosx${SDK_MAJOR}.0" \
      "$ROOT/runtime/authority/macos-broker.swift" \
      -o "$WORK/macos-broker"
  AGENT_HARNESS_AUTHORITY_SELF_TEST=1 "$WORK/macos-broker" --self-test
  exit 0
fi

canonical_path() {
  local target="$1"
  local link
  local remaining=40
  while [ -L "$target" ]; do
    [ "$remaining" -gt 0 ] || return 1
    remaining=$((remaining - 1))
    link="$(readlink "$target")"
    case "$link" in
      /*) target="$link" ;;
      *) target="$(dirname "$target")/$link" ;;
    esac
  done
  printf '%s/%s\n' \
    "$(cd "$(dirname "$target")" && pwd -P)" \
    "$(basename "$target")"
}

authority_error() {
  echo "$1" >&2
  exit 1
}

CURRENT_UID="$(/usr/bin/id -u)"
SOURCE="$ROOT/runtime/authority/macos-broker.swift"
CACHE_ROOT="$ROOT/runtime/authority/.ah-authority-cache"
CACHE_BINARY="$CACHE_ROOT/macos-broker"
CACHE_MANIFEST="$CACHE_ROOT/manifest"
CACHE_LOCK="$CACHE_ROOT/.build-lock"
umask 077

stable_digest() {
  local target="$1"
  local before
  local after
  local kind
  local owner
  local mode
  local device
  local inode
  local digest
  [ ! -L "$target" ] ||
    authority_error "native authority input must not be a symlink"
  before="$(/usr/bin/stat -f '%HT|%u|%Lp|%d|%i' "$target")" ||
    authority_error "native authority input metadata unavailable"
  IFS='|' read -r kind owner mode device inode <<<"$before"
  [ "$kind" = "Regular File" ] ||
    authority_error "native authority input must be a regular file"
  digest="$(/usr/bin/shasum -a 256 "$target" |
    /usr/bin/awk '{print $1}')" ||
    authority_error "native authority input digest unavailable"
  after="$(/usr/bin/stat -f '%HT|%u|%Lp|%d|%i' "$target")" ||
    authority_error "native authority input metadata unavailable"
  [ "$after" = "$before" ] ||
    authority_error "native authority input changed while hashing"
  printf '%s\n' "$digest"
}

validate_cache_directory() {
  local metadata
  local kind
  local owner
  local mode
  local device
  local inode
  [ ! -L "$CACHE_ROOT" ] || return 1
  metadata="$(/usr/bin/stat -f '%HT|%u|%Lp|%d|%i' "$CACHE_ROOT")" ||
    return 1
  IFS='|' read -r kind owner mode device inode <<<"$metadata"
  [ "$kind" = "Directory" ] &&
    [ "$owner" = "$CURRENT_UID" ] &&
    [ "$mode" = "700" ]
}

cache_file_digest() {
  local target="$1"
  local expected_mode="$2"
  local before
  local after
  local kind
  local owner
  local mode
  local device
  local inode
  local digest
  [ ! -L "$target" ] || return 1
  before="$(/usr/bin/stat -f '%HT|%u|%Lp|%d|%i' "$target")" ||
    return 1
  IFS='|' read -r kind owner mode device inode <<<"$before"
  [ "$kind" = "Regular File" ] &&
    [ "$owner" = "$CURRENT_UID" ] &&
    [ "$mode" = "$expected_mode" ] ||
    return 1
  digest="$(/usr/bin/shasum -a 256 "$target" |
    /usr/bin/awk '{print $1}')" ||
    return 1
  after="$(/usr/bin/stat -f '%HT|%u|%Lp|%d|%i' "$target")" ||
    return 1
  [ "$after" = "$before" ] || return 1
  printf '%s\n' "$digest"
}

WRAPPER="$(canonical_path "$0")" ||
  authority_error "authority wrapper path is unavailable"
case "$WRAPPER" in
  /*) ;;
  *) authority_error "authority wrapper path must be absolute" ;;
esac
[ "$WRAPPER" = "$0" ] ||
  authority_error "authority wrapper path must be canonical"
WRAPPER_DIGEST="$(stable_digest "$WRAPPER")"

SOURCE_REAL="$(canonical_path "$SOURCE")" ||
  authority_error "reviewed authority source is unavailable"
[ "$SOURCE_REAL" = "$SOURCE" ] ||
  authority_error "reviewed authority source path must be canonical"
SOURCE_DIGEST="$(stable_digest "$SOURCE")"

SWIFTC_DISCOVERED="$(/usr/bin/xcrun --find swiftc)"
SWIFTC_REAL="$(canonical_path "$SWIFTC_DISCOVERED")" ||
  authority_error "Swift compiler path is unavailable"
SWIFTC="$SWIFTC_DISCOVERED"
SWIFTC_DIGEST="$(stable_digest "$SWIFTC_REAL")"
SDK_DISCOVERED="$(/usr/bin/xcrun --sdk macosx --show-sdk-path)"
SDK="$(canonical_path "$SDK_DISCOVERED")" ||
  authority_error "macOS SDK path is unavailable"
SDK_VERSION="$(/usr/bin/xcrun --sdk macosx --show-sdk-version)"
SDK_MAJOR="${SDK_VERSION%%.*}"
ARCH="$(/usr/bin/uname -m)"
BUILD_IDENTITY="$(
  {
    printf 'source_sha256=%s\n' "$SOURCE_DIGEST"
    printf 'swiftc_path=%s\n' "$SWIFTC_REAL"
    printf 'swiftc_sha256=%s\n' "$SWIFTC_DIGEST"
    printf 'sdk_path=%s\n' "$SDK"
    printf 'sdk_version=%s\n' "$SDK_VERSION"
    printf 'target=%s-apple-macosx%s.0\n' "$ARCH" "$SDK_MAJOR"
  } | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
)"

if [ ! -e "$CACHE_ROOT" ]; then
  /bin/mkdir "$CACHE_ROOT" ||
    authority_error "native authority cache creation failed"
  /bin/chmod 700 "$CACHE_ROOT"
fi
validate_cache_directory ||
  authority_error "native authority cache ownership or mode mismatch"

cache_is_valid() {
  local manifest_build
  local manifest_digest
  local manifest_identity
  local actual_digest
  [ -e "$CACHE_BINARY" ] && [ -e "$CACHE_MANIFEST" ] || return 1
  cache_file_digest "$CACHE_MANIFEST" 400 >/dev/null || return 1
  [ "$(/usr/bin/awk 'END { print NR }' "$CACHE_MANIFEST")" = "3" ] ||
    return 1
  manifest_build="$(/usr/bin/sed -n '1p' "$CACHE_MANIFEST")"
  manifest_digest="$(/usr/bin/sed -n '2p' "$CACHE_MANIFEST")"
  manifest_identity="$(/usr/bin/sed -n '3p' "$CACHE_MANIFEST")"
  [ "$manifest_build" = "$BUILD_IDENTITY" ] || return 1
  case "$manifest_digest" in
    *[!0-9a-f]*|"") return 1 ;;
  esac
  [ "${#manifest_digest}" -eq 64 ] || return 1
  [ -n "$manifest_identity" ] || return 1
  actual_digest="$(cache_file_digest "$CACHE_BINARY" 500)" || return 1
  [ "$actual_digest" = "$manifest_digest" ]
}

LOCK_HELD=0
BUILD_WORK=""
cleanup_build() {
  if [ -n "$BUILD_WORK" ] && [ -d "$BUILD_WORK" ]; then
    /bin/rm -rf "$BUILD_WORK"
  fi
  if [ "$LOCK_HELD" -eq 1 ]; then
    /bin/rmdir "$CACHE_LOCK" 2>/dev/null || true
  fi
}
trap cleanup_build EXIT HUP INT TERM

/bin/mkdir "$CACHE_LOCK" 2>/dev/null ||
  authority_error "native authority cache is locked"
LOCK_HELD=1
/bin/chmod 700 "$CACHE_LOCK"
LOCK_METADATA="$(/usr/bin/stat -f '%HT|%u|%Lp' "$CACHE_LOCK")"
[ "$LOCK_METADATA" = "Directory|$CURRENT_UID|700" ] ||
  authority_error "native authority cache lock metadata mismatch"

if ! cache_is_valid; then
  BUILD_WORK="$(/usr/bin/mktemp -d "$CACHE_ROOT/.build.XXXXXX")" ||
    authority_error "native authority build workspace creation failed"
  /bin/chmod 700 "$BUILD_WORK"
  CANDIDATE="$BUILD_WORK/macos-broker"
  SWIFT_MODULECACHE_PATH="$BUILD_WORK/swift-module-cache" \
    CLANG_MODULE_CACHE_PATH="$BUILD_WORK/clang-module-cache" \
    "$SWIFTC" -sdk "$SDK" -target "$ARCH-apple-macosx${SDK_MAJOR}.0" \
      "$SOURCE" -o "$CANDIDATE"
  /bin/chmod 500 "$CANDIDATE"
  CANDIDATE_DIGEST="$(cache_file_digest "$CANDIDATE" 500)" ||
    authority_error "compiled native authority metadata mismatch"
  CANDIDATE_ATTESTATION="$("$CANDIDATE" --attest)" ||
    authority_error "compiled native authority attestation failed"
  CANDIDATE_IDENTITY="$(printf '%s' "$CANDIDATE_ATTESTATION" |
    /usr/bin/plutil -extract code_identity raw -o - -- -)" ||
    authority_error "compiled native authority code identity unavailable"
  CANDIDATE_SELF_DIGEST="$(printf '%s' "$CANDIDATE_ATTESTATION" |
    /usr/bin/plutil -extract content_digest raw -o - -- -)" ||
    authority_error "compiled native authority digest unavailable"
  [ "$CANDIDATE_SELF_DIGEST" = "$CANDIDATE_DIGEST" ] ||
    authority_error "compiled native authority self-digest mismatch"
  case "$CANDIDATE_IDENTITY" in
    *$'\n'*|"") authority_error "compiled native authority identity is invalid" ;;
  esac
  MANIFEST="$BUILD_WORK/manifest"
  printf '%s\n%s\n%s\n' \
    "$BUILD_IDENTITY" "$CANDIDATE_DIGEST" "$CANDIDATE_IDENTITY" >"$MANIFEST"
  /bin/chmod 400 "$MANIFEST"
  cache_file_digest "$MANIFEST" 400 >/dev/null ||
    authority_error "native authority manifest metadata mismatch"
  /bin/mv -f "$CANDIDATE" "$CACHE_BINARY"
  /bin/mv -f "$MANIFEST" "$CACHE_MANIFEST"
  cache_is_valid ||
    authority_error "native authority cache readback mismatch"
fi

if [ -n "$BUILD_WORK" ]; then
  /bin/rm -rf "$BUILD_WORK"
fi
BUILD_WORK=""
/bin/rmdir "$CACHE_LOCK" ||
  authority_error "native authority cache unlock failed"
LOCK_HELD=0
trap - EXIT HUP INT TERM

cache_is_valid ||
  authority_error "native authority cache changed before attestation"
ATTESTATION="$("$CACHE_BINARY" --attest)" ||
  authority_error "native authority attestation failed"
ACTUAL_IDENTITY="$(printf '%s' "$ATTESTATION" |
  /usr/bin/plutil -extract code_identity raw -o - -- -)" ||
  authority_error "native authority code identity unavailable"
ATTESTED_DIGEST="$(printf '%s' "$ATTESTATION" |
  /usr/bin/plutil -extract content_digest raw -o - -- -)" ||
  authority_error "native authority digest unavailable"
EXPECTED_DIGEST="$(/usr/bin/sed -n '2p' "$CACHE_MANIFEST")"
EXPECTED_IDENTITY="$(/usr/bin/sed -n '3p' "$CACHE_MANIFEST")"
[ "$ACTUAL_IDENTITY" = "$EXPECTED_IDENTITY" ] ||
  authority_error "native authority code identity mismatch"
[ "$ATTESTED_DIGEST" = "$EXPECTED_DIGEST" ] ||
  authority_error "native authority self-digest mismatch"
cache_is_valid ||
  authority_error "native authority cache changed after attestation"

if [ "${1:-}" = "--attest" ] && [ "$#" -eq 1 ]; then
  printf '%s' "$ATTESTATION" |
    /usr/bin/plutil -replace content_digest -string "$WRAPPER_DIGEST" -o - -- - |
    /usr/bin/plutil -convert json -o - -- -
  exit 0
fi

exec "$CACHE_BINARY" "$@"
