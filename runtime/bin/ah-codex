#!/usr/bin/env bash
set -euo pipefail

task_id=""
harness_mode="run"
exec_mode=0
native_worktree_requested=0
allow_native_worktree="${AGENT_HARNESS_ALLOW_NATIVE_WORKTREE:-0}"
args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --with-org-creds|--with-org-creds=*)
      echo "Agent harness blocked raw org-credential export. Use connector-native auth and external_write_intent." >&2
      exit 2
      ;;
    --task)
      [ "$#" -ge 2 ] || { echo "--task requires a task id" >&2; exit 2; }
      task_id="${2:-}"
      shift 2
      ;;
    --task=*)
      task_id="${1#--task=}"
      shift
      ;;
    --harness-mode)
      [ "$#" -ge 2 ] || { echo "--harness-mode requires a value" >&2; exit 2; }
      harness_mode="${2:-}"
      shift 2
      ;;
    --harness-mode=*)
      harness_mode="${1#--harness-mode=}"
      shift
      ;;
    -w|--worktree|--worktree-base|--worktree=*|--worktree-base=*|--skip-worktree-setup)
      native_worktree_requested=1
      args+=("$1")
      shift
      ;;
    *)
      [ "$1" = "exec" ] && exec_mode=1
      args+=("$1")
      shift
      ;;
  esac
done

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
  script_path="$(readlink "$script_path")"
  case "$script_path" in /*) ;; *) script_path="$script_dir/$script_path" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
export AGENT_HARNESS_ROOT="$(cd "$script_dir/.." && pwd -P)"
source "$AGENT_HARNESS_ROOT/bin/env-scrub.sh"
agent_harness_scrub_env

is_metadata_command() {
  local previous=""
  for value in "$@"; do
    case "$value" in -h|--help|--version|version) return 0 ;; esac
    if [ "$value" = "list" ] && { [ "$previous" = "features" ] || [ "$previous" = "mcp" ]; }; then return 0; fi
    previous="$value"
  done
  return 1
}

metadata_command=0
if [ "${#args[@]}" -gt 0 ] && is_metadata_command "${args[@]}"; then
  metadata_command=1
fi

if [ -n "$task_id" ] && ! [[ "$task_id" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,95}$ ]]; then
  echo "Invalid agent harness task id: $task_id" >&2
  exit 2
fi
if [ -z "$task_id" ] && [ "$metadata_command" -eq 0 ]; then
  echo "Agent harness requires --task <task-id> for agent sessions." >&2
  exit 2
fi
if [ -n "$task_id" ] && [ "$native_worktree_requested" -eq 1 ] && [ "$allow_native_worktree" != "1" ] && [ "$metadata_command" -eq 0 ]; then
  echo "Agent harness blocked native worktree flags for task $task_id. Use the harness-managed worktree unless the packet explicitly allows otherwise." >&2
  exit 2
fi
if [ -n "$task_id" ]; then
  export AGENT_HARNESS_TASK_ID="$task_id"
  if [ "$exec_mode" -eq 1 ]; then
    # Bounded exec roles report to their conductor; they do not own task completion.
    unset AGENT_HARNESS_REQUIRE_EVIDENCE || true
    export AGENT_HARNESS_SKIP_STOP_GATE=1
  else
    export AGENT_HARNESS_REQUIRE_EVIDENCE=1
  fi
fi
case "$harness_mode" in
  plan|run|yolo) export AGENT_HARNESS_MODE="$harness_mode" ;;
  *) echo "Unknown --harness-mode: $harness_mode" >&2; exit 2 ;;
esac

if [ "${#args[@]}" -eq 0 ]; then
  exec codex
fi
exec codex "${args[@]}"
