#!/usr/bin/env bash
set -euo pipefail

task_id=""
harness_mode="run"
args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --with-org-creds|--with-org-creds=*)
      echo "Agent harness blocked raw org-credential export. Use connector-native auth and external_write_intent." >&2
      exit 2
      ;;
    --task)
      [ "$#" -ge 2 ] || { echo "--task requires a task id" >&2; exit 2; }
      task_id="${2:-}"
      shift 2
      ;;
    --task=*)
      task_id="${1#--task=}"
      shift
      ;;
    --harness-mode)
      [ "$#" -ge 2 ] || { echo "--harness-mode requires a value" >&2; exit 2; }
      harness_mode="${2:-}"
      shift 2
      ;;
    --harness-mode=*)
      harness_mode="${1#--harness-mode=}"
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
  script_path="$(readlink "$script_path")"
  case "$script_path" in /*) ;; *) script_path="$script_dir/$script_path" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
export AGENT_HARNESS_ROOT="$(cd "$script_dir/.." && pwd -P)"
source "$AGENT_HARNESS_ROOT/bin/env-scrub.sh"
agent_harness_scrub_env

is_metadata_command() {
  for value in "$@"; do
    case "$value" in -h|--help|--version|--list-models|status|whoami|models|about) return 0 ;; esac
  done
  return 1
}

metadata_command=0
if [ "${#args[@]}" -gt 0 ] && is_metadata_command "${args[@]}"; then
  metadata_command=1
fi

if [ -n "$task_id" ] && ! [[ "$task_id" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,95}$ ]]; then
  echo "Invalid agent harness task id: $task_id" >&2
  exit 2
fi
if [ -z "$task_id" ] && [ "$metadata_command" -eq 0 ]; then
  echo "Agent harness requires --task <task-id> for Cursor agent sessions." >&2
  exit 2
fi
if [ -n "$task_id" ]; then
  export AGENT_HARNESS_TASK_ID="$task_id"
  export AGENT_HARNESS_REQUIRE_EVIDENCE=1
fi

case "$harness_mode" in
  plan)
    if [ "${#args[@]}" -eq 0 ]; then
      args=(--mode plan)
    else
      args=(--mode plan "${args[@]}")
    fi
    ;;
  run) ;;
  yolo)
    if [ "${#args[@]}" -eq 0 ]; then
      args=(--yolo --sandbox disabled)
    else
      args=(--yolo --sandbox disabled "${args[@]}")
    fi
    ;;
  *) echo "Unknown --harness-mode: $harness_mode" >&2; exit 2 ;;
esac
export AGENT_HARNESS_MODE="$harness_mode"

cursor_bin="$(command -v cursor-agent 2>/dev/null || true)"
if [ -z "$cursor_bin" ]; then
  cursor_bin="$(command -v agent 2>/dev/null || true)"
fi
if [ -z "$cursor_bin" ]; then
  echo "Agent harness could not find cursor-agent or agent on PATH." >&2
  exit 127
fi

if [ "${#args[@]}" -eq 0 ]; then
  exec "$cursor_bin"
fi
exec "$cursor_bin" "${args[@]}"
