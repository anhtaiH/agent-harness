#!/usr/bin/env python3
"""Command line entrypoint for the generic local agent harness."""

from pathlib import Path
import runpy
import sys

SOURCE_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SOURCE_ROOT / "src"))
runpy.run_path(str(SOURCE_ROOT / "src" / "agent_harness.py"), run_name="__main__")
